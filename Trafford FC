<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Trafford FC Official</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
scroll-behavior:smooth;
}

body{
background:#0f172a;
color:white;
}

/* HEADER */

header{
background:linear-gradient(135deg,#001f54,#d4af37);
text-align:center;
padding:80px 20px;
}

.logo{
width:160px;
margin-bottom:20px;
}

header h1{
font-size:60px;
margin-bottom:10px;
}

header p{
font-size:20px;
}

/* NAV */

nav{
background:#111827;
padding:15px;
text-align:center;
position:sticky;
top:0;
z-index:999;
}

nav a{
color:white;
text-decoration:none;
margin:0 15px;
font-weight:bold;
}

nav a:hover{
color:#d4af37;
}

/* SECTION */

section{
padding:60px 20px;
max-width:1200px;
margin:auto;
}

.section-title{
text-align:center;
font-size:35px;
margin-bottom:30px;
color:#d4af37;
}

/* CARD */

.card{
background:#1e293b;
padding:20px;
border-radius:15px;
transition:.3s;
}

.card:hover{
transform:translateY(-8px);
}

.grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:20px;
}

/* HISTORY */

.history{
background:#1e293b;
padding:25px;
border-radius:15px;
line-height:1.8;
}

/* FILTER BUTTON */

.filter-buttons{
text-align:center;
margin-bottom:20px;
}

.filter-buttons button{
padding:10px 18px;
border:none;
margin:5px;
border-radius:8px;
background:#d4af37;
cursor:pointer;
font-weight:bold;
}

.filter-buttons button:hover{
opacity:.8;
}

/* PLAYER CARD */

.player-card{
background:#1e293b;
padding:20px;
border-radius:15px;
cursor:pointer;
text-align:center;
transition:.3s;
}

.player-card:hover{
transform:scale(1.05);
}

.player-card h3{
color:#d4af37;
}

/* FORM */

form{
background:#1e293b;
padding:25px;
border-radius:15px;
max-width:700px;
margin:auto;
}

input,select{
width:100%;
padding:12px;
margin:10px 0;
border:none;
border-radius:8px;
}

.submit-btn{
background:#d4af37;
border:none;
padding:15px;
width:100%;
border-radius:8px;
font-size:18px;
font-weight:bold;
cursor:pointer;
}

/* RESULT */

.result-box{
margin-top:20px;
background:#1e293b;
padding:20px;
border-radius:15px;
text-align:center;
}

/* POPUP */

#popup{
display:none;
position:fixed;
top:50%;
left:50%;
transform:translate(-50%,-50%);
background:#1e293b;
padding:30px;
border-radius:20px;
width:320px;
text-align:center;
z-index:9999;
box-shadow:0 0 20px rgba(0,0,0,.6);
}

#popup button{
margin-top:15px;
padding:10px 20px;
border:none;
background:#d4af37;
border-radius:8px;
cursor:pointer;
}

/* FOOTER */

footer{
background:black;
padding:30px;
text-align:center;
margin-top:50px;
}

/* GALLERY */

.gallery{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:20px;
}

.gallery-box{
height:180px;
background:#1e293b;
display:flex;
justify-content:center;
align-items:center;
border-radius:15px;
}

/* STATS */

.stats{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
gap:20px;
}

.stat-box{
background:#1e293b;
padding:25px;
text-align:center;
border-radius:15px;
}

.stat-box h2{
color:#d4af37;
}

/* MOBILE */

@media(max-width:768px){

header h1{
font-size:40px;
}

nav a{
display:block;
margin:10px 0;
}

}

</style>
</head>

<body>

<header>

<img src="/home/rehan-uddin/Downloads/503679543_17849148183495103_7406984804074471449_n.jpg" class="logo">

<h1>TRAFFORD FC</h1>

<p>Official Football Club</p>

<p>Home Ground: Dhaka Khilgaon Jorpukur Khelar Math</p>

</header>

<nav>

<a href="#history">History</a>
<a href="#leadership">Leadership</a>
<a href="#squad">Squad</a>
<a href="#stats">Stats</a>
<a href="#join">Join Team</a>
<a href="#contact">Contact</a>

</nav>

<section id="history">

<h2 class="section-title">Club History</h2>

<div class="history">

Trafford FC was founded in February 2024.

The club played its first official match in June 2025.

Since 2026 Trafford FC has regularly played football on Turf Grounds and continues to develop as a competitive football club.

</div>

</section>

<section id="leadership">

<h2 class="section-title">Leadership Team</h2>

<div class="grid">

<div class="card">
<h3>👑 Tasnim</h3>
<p>Captain</p>
</div>

<div class="card">
<h3>⭐ Rehan</h3>
<p>Vice Captain</p>
</div>
<div class="card">
<h3>⭐ Ushayed</h3>
<p>Vice Captain</p>
</div>

<div class="card">
<h3>⭐ Rishat</h3>
<p>Vice Captain</p>
</div>

</div>

</section>

<section id="squad">

<h2 class="section-title">Current Squad</h2>

<div class="filter-buttons">

<button onclick="filterPlayers('All')">All</button>
<button onclick="filterPlayers('Goalkeeper')">GK</button>
<button onclick="filterPlayers('Defender')">DEF</button>
<button onclick="filterPlayers('Midfielder')">MID</button>
<button onclick="filterPlayers('Striker')">ST</button>
<button onclick="filterPlayers('Right Winger')">RW</button>
<button onclick="filterPlayers('Left Winger')">LW</button>

</div>

<div class="grid" id="players"></div>

</section>

<section id="stats">

<h2 class="section-title">Club Statistics</h2>

<div class="stats">

<div class="stat-box">
<h2>15</h2>
<p>Players</p>
</div>

<div class="stat-box">
<h2>2024</h2>
<p>Founded</p>
</div>

<div class="stat-box">
<h2>2025</h2>
<p>First Match</p>
</div>

<div class="stat-box">
<h2>2026</h2>
<p>Turf Era</p>
</div>

</div>

</section>

<section>

<h2 class="section-title">Gallery</h2>

<div class="gallery">

<div class="gallery-box">Team Photo</div>

<div class="gallery-box">Match Photo</div>

<div class="gallery-box">Training Photo</div>

</div>

</section>

<section id="join">

<h2 class="section-title">Join Trafford FC</h2>

<form id="applyForm">

<input type="text" id="name" placeholder="Full Name" required>

<input type="number" id="age" placeholder="Age" required>

<input type="text" id="address" placeholder="Address" required>

<input type="text" id="playground" placeholder="Where Do You Play?" required>

<select id="position">

<option>Goalkeeper</option>
<option>Defender</option>
<option>Midfielder</option>
<option>Striker</option>
<option>Right Winger</option>
<option>Left Winger</option>

</select>

<input type="text" id="phone" placeholder="Phone Number" required>

<button class="submit-btn">
Apply Now
</button>

</form>

<div class="result-box" id="resultBox">

No Application Submitted Yet

</div>

</section>

<section id="contact">

<h2 class="section-title">Contact</h2>

<div class="history">

📞 Contact: 01577281508

<br><br>

🏟️ Home Ground:
Dhaka Khilgaon Jorpukur Khelar Math

<br><br>

📸 Instagram:
Trafford FC Official

</div>

</section>

<div id="popup">

<h2 id="pName"></h2>

<p id="pPosition"></p>

<p id="pClub"></p>

<button onclick="closePopup()">
Close
</button>

</div>

<footer>

© 2026 Trafford FC

</footer>

<script>

const squad = [

{name:"Ariyan",position:"Goalkeeper",club:"Trafford FC"},
{name:"Irfan",position:"Goalkeeper",club:"Trafford FC"},

{name:"Rehan",position:"Defender",club:"Trafford FC"},
{name:"Tasnim",position:"Defender",club:"Trafford FC"},
{name:"Shafin",position:"Defender",club:"Trafford FC"},
{name:"Rishat",position:"Defender",club:"Trafford FC"},
{name:"Soad",position:"Defender",club:"Trafford FC"},

{name:"Sun",position:"Midfielder",club:"Trafford FC"},
{name:"Siam",position:"Midfielder",club:"Trafford FC"},
{name:"Nahian",position:"Midfielder",club:"Trafford FC"},

{name:"Joy",position:"Striker",club:"Trafford FC"},
{name:"Sakib",position:"Striker",club:"Trafford FC"},

{name:"Ushayed",position:"Right Winger",club:"Trafford FC"},
{name:"Fahim",position:"Right Winger",club:"Trafford FC"},

{name:"Jubayer",position:"Left Winger",club:"Trafford FC"}

];

function filterPlayers(position){

let html = "";

squad.forEach(player=>{

if(position==="All" || player.position===position){

html += `
<div class="player-card"
onclick="showPlayerInfo(
'${player.name}',
'${player.position}',
'${player.club}'
)">
<h3>⚽ ${player.name}</h3>
<p>${player.position}</p>
<p>${player.club}</p>
</div>
`;

}

});

document.getElementById("players").innerHTML = html;

}

filterPlayers("All");

function showPlayerInfo(
name,
position,
club
){

document.getElementById("pName").innerText =
name;

document.getElementById("pPosition").innerText =
"Position: " + position;

document.getElementById("pClub").innerText =
"Club: " + club;

document.getElementById("popup").style.display =
"block";

}

function closePopup(){

document.getElementById("popup").style.display =
"none";

}

const form =
document.getElementById("applyForm");

form.addEventListener("submit",function(e){

e.preventDefault();

const applicant = {

name:name.value,
age:age.value,
address:address.value,
playground:playground.value,
position:position.value,
phone:phone.value,
status:"Pending"

};

localStorage.setItem(
"traffordApplicant",
JSON.stringify(applicant)
);

document.getElementById("resultBox").innerHTML =
`
<h3>✅ Application Submitted</h3>
<p><strong>Name:</strong> ${applicant.name}</p>
<p><strong>Status:</strong> ${applicant.status}</p>
`;

form.reset();

});

const saved =
JSON.parse(
localStorage.getItem("traffordApplicant")
);

if(saved){

document.getElementById("resultBox").innerHTML =
`
<h3>${saved.name}</h3>
<p><strong>Status:</strong> ${saved.status}</p>
`;

}

</script>

</body>
</html>